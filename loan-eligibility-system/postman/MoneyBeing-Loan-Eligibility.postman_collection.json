{
  "info": {
    "name": "MoneyBeing - Loan Eligibility & Lead Management",
    "description": "Postman collection for MoneyBeing Loan Eligibility assessment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "rule_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('token', data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Current Admin",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Leads",
      "item": [
        {
          "name": "Create Lead",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Postman Test User\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"postman@example.com\",\n  \"date_of_birth\": \"1995-05-15\",\n  \"city\": \"Jaipur\",\n  \"pincode\": \"302001\",\n  \"loan_type\": \"Home Loan\",\n  \"employment_type\": \"Salaried\",\n  \"monthly_income\": 75000,\n  \"loan_amount\": 2500000,\n  \"property_value\": 5000000,\n  \"consent\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/leads",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ]
            }
          }
        },
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/leads?page=1&page_size=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search Leads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/leads?search=Rahul&page=1&page_size=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Rahul"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Eligible Leads",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/leads?bre_status=Eligible&page=1&page_size=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads"
              ],
              "query": [
                {
                  "key": "bre_status",
                  "value": "Eligible"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Dashboard Metrics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/leads/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "leads",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "BRE Rules",
      "item": [
        {
          "name": "List Rules",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rules"
              ]
            }
          }
        },
        {
          "name": "Create Rule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"field_name\": \"credit_score\",\n  \"operator\": \">=\",\n  \"value\": 700,\n  \"active\": true,\n  \"description\": \"Credit score minimum requirement\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/rules",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rules"
              ]
            }
          }
        },
        {
          "name": "Update Rule",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"field_name\": \"credit_score\",\n  \"operator\": \">=\",\n  \"value\": 700,\n  \"active\": true,\n  \"description\": \"Updated credit score requirement\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/rules/{{rule_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rules",
                "{{rule_id}}"
              ]
            }
          }
        },
        {
          "name": "Delete Rule",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/rules/{{rule_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "rules",
                "{{rule_id}}"
              ]
            }
          }
        }
      ]
    }
  ]
}